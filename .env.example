# ─────────────────────────────────────────────────────────────────
# Intelligent Event Management Platform — Environment Variables
# ─────────────────────────────────────────────────────────────────

# Flask
PORT=5000
FLASK_DEBUG=true
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Email (Flask-Mail) ────────────────────────────────────────────
# Required to send registration confirmation emails.
# Leave MAIL_USERNAME blank to disable email sending (app still works).
#
# Gmail example:
#   1. Enable 2-Step Verification on your Google account.
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Generate an App Password (select "Mail" + your device).
#   4. Paste the generated 16-char password as MAIL_PASSWORD below.
#
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ── Google Gemini AI (optional) ───────────────────────────────────
# App works fully without a key — uses mock insights instead.
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
